# ─── EmailJS (envoi de facture par email à la validation) ─────────
# Voir EMAIL_SETUP.md pour la configuration du template
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=

# false = envoi immédiat (plan Firebase Spark). true = lien PDF via Storage (Blaze)
REACT_APP_ENABLE_PDF_STORAGE=false

# ─── Serveur de dev + QR mobile ───────────────────────────────────
# Écoute sur le réseau local (optionnel)
HOST=0.0.0.0

# URL publique pour le QR (tunnel Cloudflare ou IP locale)
# Ex. https://xxxx.trycloudflare.com ou http://192.168.1.XX:3000
REACT_APP_PUBLIC_URL=

# Requis si vous utilisez un tunnel Cloudflare (trycloudflare.com)
DANGEROUSLY_DISABLE_HOST_CHECK=true
